# Environment variables — see design.md §9.
#
# Three separate Supabase projects exist (development / staging / production),
# each with its own copy of these values. Copy this file to `.env.local` for
# local development and fill in the development project's values. Never commit
# real keys; only commit this file (the `.env.example` is the sole exception
# to `.gitignore`).

# ── Supabase ──────────────────────────────────────────────────────────────
# From the Supabase project's Settings → API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only (src/lib/supabase/admin.ts). NEVER expose
# to the browser; it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ── Payments ──────────────────────────────────────────────────────────────
# Which PaymentProvider implementation src/lib/payments/index.ts resolves to.
PAYMENT_PROVIDER=intasend
# IntaSend sandbox credentials (staging/production use different keys).
INTASEND_API_KEY=
INTASEND_TOKEN=
# Secret used to verify incoming payment webhooks (design.md §5).
INTASEND_WEBHOOK_SECRET=