# Supabase — https://supabase.com/dashboard > Project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Server-only. NEVER commits to git and never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Public site origin — used to build the payment return URL (/checkout/success).
# Override per environment (local/staging/production).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment provider (design.md §5).
#   intasend — real M-Pesa/card via IntaSend (requires the INTASEND_* keys below)
#   mock     — simulated payments for local/QA; approves/declines on a built-in
#              page and drives the real webhook code at /checkout/mock
PAYMENT_PROVIDER=mock

# Notification provider for order confirmations (design.md §15 — real channel
# still an open decision). Only "mock" is implemented: it logs the
# confirmation to the server logs instead of sending.
NOTIFICATION_PROVIDER=mock

# IntaSend keys — get from https://sandbox.intasend.com (test) or
# https://payment.intasend.com (live) > Account > Settings > API Keys.
# Sandbox keys start with ISPubKey_test_ / ISSecretKey_test_.
INTASEND_PUBLISHABLE_KEY=ISPubKey_test_...
INTASEND_SECRET_KEY=ISSecretKey_test_...
# The exact "challenge" string you configured in IntaSend > Webhooks for
# the /api/webhooks/payments endpoint. It is echoed in every webhook and
# must match or the payload is rejected. In mock mode any value (e.g. "mock")
# can be used since nothing leaves the server.
INTASEND_WEBHOOK_SECRET=...